<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/deckRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_surface"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="12dp"
    android:paddingEnd="22dp"
    android:paddingBottom="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/deckBackButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="48dp" android:layout_height="48dp" android:text="‹" android:textColor="@color/brand_on_surface" android:textSize="28sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Deck" android:textColor="@color/brand_on_surface" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:id="@+id/deckComputerName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:textColor="@color/brand_muted" android:textSize="12sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="길게 눌러 버튼 변경" android:textColor="@color/brand_muted" android:textSize="12sp" />
    </LinearLayout>
    <GridLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="8dp" android:layout_weight="1" android:alignmentMode="alignMargins" android:columnCount="6" android:rowCount="2" android:useDefaultMargins="true">
        <com.google.android.material.button.MaterialButton android:id="@+id/deckSlot1" style="@style/Widget.PhoneUnlock.DeckKey" />
        <com.google.android.material.button.MaterialButton android:id="@+id/deckSlot2" style="@style/Widget.PhoneUnlock.DeckKey" />
        <com.google.android.material.button.MaterialButton android:id="@+id/deckSlot3" style="@style/Widget.PhoneUnlock.DeckKey" />
        <com.google.android.material.button.MaterialButton android:id="@+id/deckSlot4" style="@style/Widget.PhoneUnlock.DeckKey" />
        <com.google.android.material.button.MaterialButton android:id="@+id/deckSlot5" style="@style/Widget.PhoneUnlock.DeckKey" />
        <com.google.android.material.button.MaterialButton android:id="@+id/deckSlot6" style="@style/Widget.PhoneUnlock.DeckKey" />
        <com.google.android.material.button.MaterialButton android:id="@+id/deckSlot7" style="@style/Widget.PhoneUnlock.DeckKey" />
        <com.google.android.material.button.MaterialButton android:id="@+id/deckSlot8" style="@style/Widget.PhoneUnlock.DeckKey" />
        <com.google.android.material.button.MaterialButton android:id="@+id/deckSlot9" style="@style/Widget.PhoneUnlock.DeckKey" />
        <com.google.android.material.button.MaterialButton android:id="@+id/deckSlot10" style="@style/Widget.PhoneUnlock.DeckKey" />
        <com.google.android.material.button.MaterialButton android:id="@+id/deckSlot11" style="@style/Widget.PhoneUnlock.DeckKey" />
        <com.google.android.material.button.MaterialButton android:id="@+id/deckSlot12" style="@style/Widget.PhoneUnlock.DeckKey" />
    </GridLayout>
</LinearLayout>
