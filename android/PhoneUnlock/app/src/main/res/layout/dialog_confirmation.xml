<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/confirmationCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="22dp"
    app:cardBackgroundColor="@color/brand_card"
    app:cardCornerRadius="28dp"
    app:cardElevation="10dp"
    app:strokeColor="@color/brand_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/confirmationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/brand_on_surface"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/confirmationMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/brand_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirmationCancelButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minHeight="0dp"
                android:text="아니요"
                android:textColor="@color/brand_muted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirmationActionButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:minHeight="0dp"
                android:text="생체인증" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
