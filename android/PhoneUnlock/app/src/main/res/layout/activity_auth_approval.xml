<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_surface"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="28dp">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="Phone Unlock"
        android:src="@drawable/ic_phone_unlock" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Windows 로그인 요청"
        android:textColor="@color/brand_on_surface"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/authComputerNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="PC에서 로그인을 요청했습니다."
        android:textColor="@color/brand_muted"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/authCountdownText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="30초 안에 승인하세요"
        android:textColor="@color/brand_muted"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/approveButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="34dp"
        android:minHeight="56dp"
        android:text="생체인증으로 승인"
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/denyButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="52dp"
        android:text="거절" />

    <TextView
        android:id="@+id/authStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textColor="@color/brand_muted"
        android:textSize="14sp" />
</LinearLayout>
