<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PhoneUnlock.Agent</RootNamespace>
    <AssemblyName>PhoneUnlock.Agent</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- C#/WinRT projects the SDK metadata into normal .NET reference assemblies.
         This prevents .NET 8 from trying to reference raw .winmd files directly. -->
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.26100.9169" />
  </ItemGroup>
  <PropertyGroup>
    <CsWinRTIncludes>Windows.Devices.Sensors;Windows.Foundation</CsWinRTIncludes>
  </PropertyGroup>
</Project>
