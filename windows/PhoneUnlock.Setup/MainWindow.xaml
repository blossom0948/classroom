<Window x:Class="PhoneUnlock.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phone Unlock 설정"
        Width="820" Height="820" MinWidth="700" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI Variable Text"
        Foreground="{StaticResource TextBrush}"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="Phone Unlock" />
                    <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" Text="휴대폰으로 Windows를 잠그고 열기" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="UpdateButton" Style="{StaticResource SecondaryButton}" Click="Update_Click" Content="업데이트" />
                    <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="Refresh_Click" Content="새로 고침" />
                </StackPanel>
            </Grid>

            <Border x:Name="InstallRequiredCard" Margin="0,18,0,0" Padding="16" Background="#3A2528"
                    BorderBrush="#754448" BorderThickness="1" CornerRadius="12" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{StaticResource ErrorBrush}" FontWeight="SemiBold" VerticalAlignment="Center"
                               Text="서비스 설치 필요" />
                    <Button x:Name="InstallButton" Grid.Column="1" Click="Install_Click" Content="설치" />
                </Grid>
            </Border>

            <Border Margin="0,16,0,0" Padding="16" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1" CornerRadius="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ServiceStatusText" FontSize="16" FontWeight="SemiBold" Text="확인 중…" />
                        <TextBlock x:Name="ComputerText" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" x:Name="ReadyBadge" Padding="12,7" CornerRadius="16" Background="{StaticResource CardAltBrush}">
                        <TextBlock x:Name="ReadyBadgeText" FontSize="12" FontWeight="SemiBold" Text="설정 필요" />
                    </Border>
                </Grid>
            </Border>

            <StackPanel x:Name="HomePanel">
                <TextBlock Margin="0,24,0,0" FontSize="20" FontWeight="SemiBold" Text="연결된 휴대폰" />
                <ListBox x:Name="HomePhoneList" Margin="0,12,0,0" Height="150" BorderThickness="1"
                         BorderBrush="{StaticResource StrokeBrush}" Background="{StaticResource CardBrush}"
                         SelectionChanged="HomePhoneList_SelectionChanged" />
                <TextBlock x:Name="PhoneStateText" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" Text="등록된 휴대폰이 없습니다." />

                <Button x:Name="CreatePairingButton" Margin="0,14,0,0" Click="CreatePairing_Click"
                        Content="새 휴대폰 연결" HorizontalAlignment="Left" />

                <Grid x:Name="PairingPanel" Margin="0,14,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="8" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="12">
                        <Image x:Name="PairingQrImage" Width="202" Height="202" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="휴대폰 카메라로 스캔" />
                        <TextBlock x:Name="PairingExpiryText" Margin="0,8,0,0" Foreground="{StaticResource ErrorBrush}" FontWeight="SemiBold" />
                        <Button Margin="0,12,0,0" Style="{StaticResource SecondaryButton}" Click="CopyPairing_Click"
                                Content="코드 복사" HorizontalAlignment="Left" />
                        <Expander Margin="0,8,0,0" Header="연결 코드 보기">
                            <TextBox x:Name="PairingJsonBox" Margin="0,6,0,0" Height="80" IsReadOnly="True"
                                     AcceptsReturn="True" FontFamily="Cascadia Mono" FontSize="10"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        </Expander>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackToHomeButton" Style="{StaticResource SecondaryButton}" Click="BackToHome_Click" Content="‹ 목록" />
                    <TextBlock x:Name="SettingsHeaderText" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                               FontSize="20" FontWeight="SemiBold" Text="PC 설정" />
                </Grid>

                <Border Margin="0,12,0,0" Padding="18" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="1" CornerRadius="14">
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="Windows 로그인" />
                        <TextBlock x:Name="LoginStateText" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="DetectedAccountText" Margin="0,12,0,0" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock x:Name="CredentialStateText" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />

                        <Expander x:Name="CredentialExpander" Margin="0,12,0,0" Header="Windows 암호 확인 (처음 한 번)">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="PasswordInput" ToolTip="현재 Windows 계정 암호" />
                                <Button x:Name="StoreCredentialButton" Grid.Column="2" Click="StoreCredential_Click" Content="확인" />
                            </Grid>
                        </Expander>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="PhoneSelectorComboBox" DisplayMemberPath="DisplayName" VerticalContentAlignment="Center" MinHeight="38" />
                            <Button x:Name="UseSelectedPhoneButton" Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                    Click="UseSelectedPhone_Click" Content="로그인 폰 선택" />
                        </Grid>
                        <TextBlock x:Name="PhoneSelectionHint" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}"
                                   Text="로그인에 사용할 휴대폰" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="EnableLoginButton" Click="TestAndEnable_Click" Content="휴대폰 로그인 켜기" />
                            <Button x:Name="DisableLoginButton" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                                    Click="DisableLogin_Click" Content="끄기" Visibility="Collapsed" />
                        </StackPanel>
                        <TextBlock x:Name="TestResultText" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" Padding="18" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="1" CornerRadius="14">
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="자동 잠금" />
                        <CheckBox x:Name="RemoteUnlockCheckBox" Margin="0,12,0,0" FontSize="14"
                                  Content="휴대폰에서 원격 잠금 해제 허용" Click="RemoteUnlock_Click" />
                        <CheckBox x:Name="RemotePowerCheckBox" Margin="0,10,0,0" FontSize="14"
                                  Content="원격 전원 제어 허용" Click="RemotePower_Click" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="자동 잠금 프로필" />
                            <ComboBox x:Name="AutoLockProfileComboBox" Grid.Column="2" SelectionChanged="AutoLockProfile_SelectionChanged">
                                <ComboBoxItem Content="표준" Tag="standard" />
                                <ComboBoxItem Content="집" Tag="home" />
                                <ComboBoxItem Content="외출" Tag="away" />
                            </ComboBox>
                        </Grid>
                        <CheckBox x:Name="ProximityLockCheckBox" Margin="0,12,0,0" FontSize="14"
                                  Content="휴대폰이 멀어지면 PC 잠금" Click="ProximityLock_Click" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="이탈 대기" />
                            <ComboBox x:Name="ProximityGraceComboBox" Grid.Column="2" SelectionChanged="ProximityGrace_SelectionChanged">
                                <ComboBoxItem Content="10초" Tag="10" />
                                <ComboBoxItem Content="30초" Tag="30" />
                                <ComboBoxItem Content="60초" Tag="60" />
                                <ComboBoxItem Content="120초" Tag="120" />
                            </ComboBox>
                        </Grid>
                        <CheckBox x:Name="ProximityUnlockCheckBox" Margin="0,12,0,0" FontSize="14"
                                  Content="휴대폰 또는 재실 센서가 감지되면 자동 로그인" Click="ProximityUnlock_Click" />
                        <CheckBox x:Name="SmartArrivalCheckBox" Margin="0,10,0,0" FontSize="14"
                                  Content="돌아오면 휴대폰 생체인증 요청" Click="SmartArrival_Click" />
                        <CheckBox x:Name="BluetoothRssiCheckBox" Margin="0,10,0,0" FontSize="14"
                                  Content="Bluetooth 거리 기준 사용" Click="BluetoothRssi_Click" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="가까움 기준" />
                            <ComboBox x:Name="BluetoothRssiThresholdComboBox" Grid.Column="2" SelectionChanged="BluetoothRssiThreshold_SelectionChanged">
                                <ComboBoxItem Content="-60 dBm" Tag="-60" />
                                <ComboBoxItem Content="-70 dBm" Tag="-70" />
                                <ComboBoxItem Content="-75 dBm" Tag="-75" />
                                <ComboBoxItem Content="-85 dBm" Tag="-85" />
                            </ComboBox>
                        </Grid>
                        <TextBlock x:Name="ProximityAgentStatusText" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <Button x:Name="StartAgentButton" Margin="0,8,0,0" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left" Click="StartAgent_Click" Content="자동잠금 감시 시작" />
                        <TextBlock x:Name="PauseStateText" Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}"
                                   Text="자동 기능 일시 중지 안 함" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="PauseHourButton" Style="{StaticResource SecondaryButton}" Click="PauseHour_Click" Content="1시간 중지" />
                            <Button x:Name="PauseTodayButton" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="PauseToday_Click" Content="오늘까지 중지" />
                            <Button x:Name="ResumeAutomationButton" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="ResumeAutomation_Click" Content="다시 켜기" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" Padding="18" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="1" CornerRadius="14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="재실 센서" />
                            <CheckBox x:Name="PresenceSensorCheckBox" Grid.Column="1" VerticalAlignment="Center"
                                      Content="사람이 없으면 잠금" Click="PresenceSensor_Click" />
                        </Grid>
                        <TextBlock x:Name="PresenceSensorStateText" Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <Button x:Name="TestPresenceSensorButton" Margin="0,10,0,0" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left" Click="TestPresenceSensor_Click" Content="현재 상태 테스트" />
                        <ComboBox x:Name="PresenceSensorProtocolComboBox" Margin="0,10,0,0"
                                  SelectionChanged="PresenceSensorProtocol_SelectionChanged">
                            <ComboBoxItem Content="Zigbee · Home Assistant" Tag="zigbee" />
                            <ComboBoxItem Content="Matter · Home Assistant" Tag="matter" />
                            <ComboBoxItem Content="SmartThings Station" Tag="smartthings" />
                        </ComboBox>
                        <StackPanel x:Name="SmartThingsQuickSetupPanel" Margin="0,10,0,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="SmartThings 센서" />
                                    <TextBlock x:Name="SmartThingsQuickStatusText" Margin="0,3,0,0"
                                               Foreground="{StaticResource MutedBrush}" Text="센서 이름을 자동으로 불러옵니다." />
                                </StackPanel>
                                <Button x:Name="SmartThingsQuickConnectButton" Grid.Column="2"
                                        Style="{StaticResource SecondaryButton}" Click="SmartThingsQuickConnect_Click"
                                        Content="센서 자동 연결" />
                            </Grid>
                            <ComboBox x:Name="SmartThingsSensorComboBox" Margin="0,8,0,0"
                                      DisplayMemberPath="DisplayName" Visibility="Collapsed"
                                      SelectionChanged="SmartThingsSensor_SelectionChanged" />
                            <Button x:Name="SmartThingsUseSensorButton" Margin="0,8,0,0"
                                    Click="SmartThingsUseSensor_Click" Content="선택한 센서로 연결"
                                    HorizontalAlignment="Left" Visibility="Collapsed" />
                        </StackPanel>
                        <Expander x:Name="PresenceConnectionExpander" Margin="0,8,0,0" Header="고급 설정 (수동 입력)">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock x:Name="PresenceSensorTargetHint" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                           Text="Home Assistant entity_id" />
                                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="API 주소" />
                                <TextBox x:Name="PresenceSensorUrlInput" Margin="0,8,0,0" ToolTip="Home Assistant 또는 SmartThings API 주소"
                                         Text="http://homeassistant.local:8123" />
                                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="센서 ID" />
                                <TextBox x:Name="PresenceSensorEntityInput" Margin="0,8,0,0" ToolTip="센서 entity_id 또는 device ID" />
                                <StackPanel x:Name="SmartThingsFieldsPanel" Visibility="Collapsed">
                                    <TextBox x:Name="PresenceSensorComponentInput" Margin="0,8,0,0" ToolTip="SmartThings component ID" Text="main" />
                                    <TextBox x:Name="PresenceSensorCapabilityInput" Margin="0,8,0,0" ToolTip="SmartThings capability ID" Text="occupancySensor" />
                                    <TextBox x:Name="PresenceSensorAttributeInput" Margin="0,8,0,0" ToolTip="SmartThings attribute name" Text="occupancy" />
                                    <Button x:Name="FindSmartThingsSensorsButton" Margin="0,10,0,0"
                                            Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                            Click="FindSmartThingsSensors_Click" Content="고급: 센서 목록 다시 불러오기" />
                                </StackPanel>
                                <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="액세스 토큰" />
                                <PasswordBox x:Name="PresenceSensorTokenInput" Margin="0,4,0,0" ToolTip="Home Assistant 토큰 또는 SmartThings Personal Access Token" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="감지 해제 후" />
                                    <ComboBox x:Name="PresenceSensorGraceComboBox" Grid.Column="2" SelectionChanged="PresenceSensorGrace_SelectionChanged">
                                        <ComboBoxItem Content="10초" Tag="10" />
                                        <ComboBoxItem Content="30초" Tag="30" />
                                        <ComboBoxItem Content="60초" Tag="60" />
                                    </ComboBox>
                                    <TextBlock Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center" Text="뒤 잠금" />
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" Padding="18" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="1" CornerRadius="14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="보안 점검" />
                            <Button x:Name="SecurityCheckupButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                    Click="SecurityCheckup_Click" Content="검사 실행" />
                        </Grid>
                        <TextBlock x:Name="SecurityCheckupSummaryText" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" Text="아직 보안 점검을 실행하지 않았습니다." />
                        <ListBox x:Name="SecurityCheckupList" Margin="0,8,0,0" Height="150" BorderThickness="0" Background="{StaticResource CardAltBrush}" FontSize="12" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="RevokePhoneButton" Style="{StaticResource SecondaryButton}" Click="RevokePhone_Click"
                                    Content="선택한 휴대폰 즉시 차단" />
                            <Button x:Name="RevokeAllPhonesButton" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                                    Click="RevokeAllPhones_Click" Content="모든 휴대폰 차단" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" Padding="18" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="1" CornerRadius="14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="보안 기록" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="AuditRefresh_Click" Content="새로 고침" />
                        </Grid>
                        <ListBox x:Name="AuditList" Margin="0,10,0,0" Height="180" BorderThickness="0" Background="{StaticResource CardAltBrush}" FontSize="12" />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" Padding="18" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="1" CornerRadius="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="DiagnosticsButton" Click="Diagnostics_Click" Content="이 PC 연결 진단" HorizontalAlignment="Left" />
                            <Button x:Name="ExportDiagnosticsButton" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                                    Click="ExportDiagnostics_Click" Content="진단 저장" HorizontalAlignment="Left" />
                        </StackPanel>
                        <TextBlock x:Name="DiagnosticsSummaryText" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <TextBlock x:Name="OperationStatusText" Margin="0,14,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Window>
