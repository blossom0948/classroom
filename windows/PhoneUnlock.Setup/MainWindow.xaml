<Window x:Class="PhoneUnlock.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phone Unlock 설정"
        Width="840" Height="820" MinWidth="720" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8"
        FontFamily="Segoe UI Variable Text"
        Foreground="{StaticResource TextBrush}"
        Loaded="Window_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="30" FontWeight="SemiBold" Text="Phone Unlock" />
                    <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"
                               Text="휴대폰 인증으로 이 PC를 안전하게 잠금 해제합니다" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UpdateButton" Style="{StaticResource SecondaryButton}" Click="Update_Click"
                            Content="업데이트 확인" />
                    <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="Refresh_Click"
                            Content="새로 고침" />
                </StackPanel>
            </Grid>

            <Border x:Name="InstallRequiredCard" Margin="0,22,0,0" Padding="20" Background="#FFF0F0"
                    BorderBrush="#F2B8B5" BorderThickness="1" CornerRadius="12" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#8A2424"
                                   Text="설치가 아직 끝나지 않았습니다" />
                        <TextBlock Margin="0,7,20,0" Foreground="#8A2424" TextWrapping="Wrap"
                                   Text="서비스 설치가 중간에 멈췄습니다. ZIP이나 PowerShell 없이 최신 설치 프로그램 하나로 복구할 수 있습니다." />
                    </StackPanel>
                    <Button x:Name="InstallButton" Grid.Column="1" Click="Install_Click"
                            Content="설치 프로그램 받기" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Margin="0,16,0,0" Padding="18" Background="White" BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Text="현재 상태" />
                        <TextBlock x:Name="ServiceStatusText" Margin="0,5,0,0" FontSize="18" FontWeight="SemiBold" Text="확인 중…" />
                        <TextBlock x:Name="ComputerText" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" x:Name="ReadyBadge" Padding="13,8" CornerRadius="18"
                            Background="#ECEEF2" VerticalAlignment="Center">
                        <TextBlock x:Name="ReadyBadgeText" FontSize="12" FontWeight="SemiBold" Text="설정 필요" />
                    </Border>
                </Grid>
            </Border>

            <Border Margin="0,16,0,0" Padding="22" Background="White" BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1" CornerRadius="12">
                <StackPanel>
                    <TextBlock FontSize="19" FontWeight="SemiBold" Text="1. 휴대폰 연결" />
                    <TextBlock Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Text="Windows에서 QR을 만들고 휴대폰 앱으로 스캔하면 바로 연결됩니다." />
                    <Button x:Name="CreatePairingButton" Margin="0,14,0,0" Click="CreatePairing_Click"
                            Content="연결 QR 코드 만들기" HorizontalAlignment="Left" />

                    <Grid x:Name="PairingPanel" Margin="0,16,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="10" Background="White" BorderBrush="#D8DAE0" BorderThickness="1" CornerRadius="10">
                            <Image x:Name="PairingQrImage" Width="238" Height="238" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="휴대폰에서 스캔하세요" />
                            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Text="Phone Unlock 앱 → PC 연결 → QR 코드 스캔" />
                            <TextBlock x:Name="PairingExpiryText" Margin="0,13,0,0" Foreground="#A15C00"
                                       FontWeight="SemiBold" Text="이 코드는 2분 동안 유효합니다." />
                            <Button Margin="0,16,0,0" Style="{StaticResource SecondaryButton}"
                                    Click="CopyPairing_Click" Content="스캔이 안 되면 코드 복사" HorizontalAlignment="Left" />
                            <Expander Margin="0,10,0,0" Header="연결 코드 보기">
                                <TextBox x:Name="PairingJsonBox" Margin="0,8,0,0" Height="92" IsReadOnly="True"
                                         AcceptsReturn="True" FontFamily="Cascadia Mono" FontSize="10"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                            </Expander>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="PhoneStateText" Margin="0,14,0,0" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Text="연결된 휴대폰이 없습니다." />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="PhoneSelectorComboBox" DisplayMemberPath="DisplayName"
                                  VerticalContentAlignment="Center" MinHeight="38" />
                        <Button x:Name="UseSelectedPhoneButton" Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                Click="UseSelectedPhone_Click" Content="로그인 폰으로 선택" />
                    </Grid>
                    <TextBlock x:Name="PhoneSelectionHint" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Text="여러 휴대폰을 등록하면 로그인에 사용할 폰을 여기서 선택할 수 있습니다." />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="DiagnosticsButton" Click="Diagnostics_Click" Content="이 PC 연결 진단" />
                        <TextBlock x:Name="DiagnosticsSummaryText" Grid.Column="2" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0" Padding="22" Background="White" BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="19" FontWeight="SemiBold" Text="2. 이 PC 암호 확인" />
                        <TextBlock Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   Text="계정은 자동으로 선택했습니다. PIN이 아닌 현재 Windows 계정 암호를 한 번만 입력하세요." />
                        <TextBlock Margin="0,15,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="자동 선택된 계정" />
                        <TextBlock x:Name="DetectedAccountText" Margin="0,4,0,0" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="CredentialStateText" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <PasswordBox x:Name="PasswordInput" ToolTip="Windows PIN이 아닌 계정 암호" />
                        <Button x:Name="StoreCredentialButton" Margin="0,10,0,0" Click="StoreCredential_Click"
                                Content="암호 확인하고 저장" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Margin="0,16,0,0" Padding="22" Background="White" BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="19" FontWeight="SemiBold" Text="3. 휴대폰 인증 로그인 켜기" />
                        <TextBlock Margin="0,7,18,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   Text="휴대폰에 인증 테스트를 한 번 보냅니다. 성공하면 잠금화면에서 Phone Unlock이 기본으로 열리고 요청도 자동 전송됩니다." />
                        <TextBlock x:Name="TestResultText" Margin="0,12,0,0" FontWeight="SemiBold" Text="휴대폰과 암호 설정 후 진행하세요." />
                        <TextBlock x:Name="LoginStateText" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="EnableLoginButton" Click="TestAndEnable_Click" Content="휴대폰 인증 로그인 켜기" />
                        <Button x:Name="DisableLoginButton" Margin="0,8,0,0" Style="{StaticResource SecondaryButton}"
                                Click="DisableLogin_Click" Content="휴대폰 인증 로그인 끄기" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Margin="0,16,0,0" Padding="22" Background="White" BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1" CornerRadius="12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="19" FontWeight="SemiBold" Text="보안 기록" />
                            <TextBlock Margin="0,7,18,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Text="언제, 어떤 휴대폰과 IP에서 요청이 성공·실패했는지 확인합니다. 서명 불일치나 알 수 없는 폰은 의심스러운 요청으로 표시됩니다." />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="AuditRefresh_Click" Content="기록 새로 고침" />
                    </Grid>
                    <ListBox x:Name="AuditList" Margin="0,14,0,0" Height="190" BorderThickness="0"
                             Background="#F8F9FB" FontSize="12" />
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0" Padding="22" Background="White" BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1" CornerRadius="12">
                <StackPanel>
                    <TextBlock FontSize="19" FontWeight="SemiBold" Text="휴대폰 거리 이탈 보호" />
                    <CheckBox x:Name="ProximityLockCheckBox" Margin="0,14,0,0" FontSize="15"
                              Content="휴대폰 연결이 끊기면 PC 자동 잠금" Click="ProximityLock_Click" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="연결 끊김 대기 시간" />
                        <ComboBox x:Name="ProximityGraceComboBox" Margin="14,0,0,0" Width="120"
                                  SelectionChanged="ProximityGrace_SelectionChanged">
                            <ComboBoxItem Content="10초" Tag="10" />
                            <ComboBoxItem Content="30초" Tag="30" />
                            <ComboBoxItem Content="60초" Tag="60" />
                            <ComboBoxItem Content="120초" Tag="120" />
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Margin="0,10,0,0" Foreground="#8A5A00" TextWrapping="Wrap"
                               Text="안전한 기본값은 꺼짐입니다. 이 기능은 GPS 거리를 재는 것이 아니라 휴대폰과 PC의 보안 연결이 끊긴 뒤 잠그는 방식이며, Wi-Fi 절전·네트워크 변경 때도 작동할 수 있습니다." />
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0" Padding="18" Background="#FFF4D6" CornerRadius="12">
                <TextBlock Foreground="#765100" TextWrapping="Wrap"
                           Text="PIN·비밀번호·Windows Hello는 그대로 유지됩니다. 휴대폰이 없거나 연결되지 않으면 로그인 옵션에서 기존 PIN을 선택할 수 있습니다." />
            </Border>

            <TextBlock x:Name="OperationStatusText" Margin="0,16,0,0" Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Window>
