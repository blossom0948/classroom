<Window x:Class="PhoneUnlock.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phone Unlock 설정"
        Width="760" Height="760" MinWidth="680" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8"
        FontFamily="Segoe UI Variable Text"
        Foreground="{StaticResource TextBrush}"
        Loaded="Window_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="Phone Unlock" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="UpdateButton" Style="{StaticResource SecondaryButton}" Click="Update_Click" Content="업데이트" />
                    <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="Refresh_Click" Content="새로 고침" />
                </StackPanel>
            </Grid>

            <Border x:Name="InstallRequiredCard" Margin="0,18,0,0" Padding="16" Background="#FFF0F0"
                    BorderBrush="#F2B8B5" BorderThickness="1" CornerRadius="12" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="#8A2424" FontWeight="SemiBold" VerticalAlignment="Center"
                               Text="서비스 설치 필요" />
                    <Button x:Name="InstallButton" Grid.Column="1" Click="Install_Click" Content="설치" />
                </Grid>
            </Border>

            <Border Margin="0,14,0,0" Padding="16" Background="White" BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ServiceStatusText" FontSize="16" FontWeight="SemiBold" Text="확인 중…" />
                        <TextBlock x:Name="ComputerText" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" x:Name="ReadyBadge" Padding="12,7" CornerRadius="16" Background="#ECEEF2">
                        <TextBlock x:Name="ReadyBadgeText" FontSize="12" FontWeight="SemiBold" Text="설정 필요" />
                    </Border>
                </Grid>
            </Border>

            <StackPanel x:Name="HomePanel">
                <TextBlock Margin="0,24,0,0" FontSize="20" FontWeight="SemiBold" Text="연결된 휴대폰" />
                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" Text="휴대폰을 선택하면 설정을 엽니다." />

                <ListBox x:Name="HomePhoneList" Margin="0,12,0,0" Height="150" BorderThickness="0"
                         Background="White" SelectionChanged="HomePhoneList_SelectionChanged" />
                <TextBlock x:Name="PhoneStateText" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" Text="등록된 휴대폰이 없습니다." />

                <Button x:Name="CreatePairingButton" Margin="0,14,0,0" Click="CreatePairing_Click"
                        Content="새 휴대폰 연결" HorizontalAlignment="Left" />

                <Grid x:Name="PairingPanel" Margin="0,14,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="8" Background="White" BorderBrush="#D8DAE0" BorderThickness="1" CornerRadius="10">
                        <Image x:Name="PairingQrImage" Width="202" Height="202" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="휴대폰으로 스캔" />
                        <TextBlock x:Name="PairingExpiryText" Margin="0,8,0,0" Foreground="#A15C00" FontWeight="SemiBold" />
                        <Button Margin="0,12,0,0" Style="{StaticResource SecondaryButton}" Click="CopyPairing_Click"
                                Content="코드 복사" HorizontalAlignment="Left" />
                        <Expander Margin="0,8,0,0" Header="코드 보기">
                            <TextBox x:Name="PairingJsonBox" Margin="0,6,0,0" Height="80" IsReadOnly="True"
                                     AcceptsReturn="True" FontFamily="Cascadia Mono" FontSize="10"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        </Expander>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackToHomeButton" Style="{StaticResource SecondaryButton}" Click="BackToHome_Click" Content="‹ 목록" />
                    <TextBlock x:Name="SettingsHeaderText" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                               FontSize="20" FontWeight="SemiBold" Text="PC 설정" />
                </Grid>

                <Border Margin="0,12,0,0" Padding="18" Background="White" BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="1" CornerRadius="12">
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="로그인" />
                        <TextBlock x:Name="LoginStateText" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Margin="0,14,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="Windows 계정" />
                        <TextBlock x:Name="DetectedAccountText" Margin="0,3,0,0" FontSize="14" FontWeight="SemiBold" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="PasswordInput" ToolTip="Windows 계정 암호" />
                            <Button x:Name="StoreCredentialButton" Grid.Column="2" Click="StoreCredential_Click" Content="암호 확인" />
                        </Grid>
                        <TextBlock x:Name="CredentialStateText" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="PhoneSelectorComboBox" DisplayMemberPath="DisplayName" VerticalContentAlignment="Center" MinHeight="36" />
                            <Button x:Name="UseSelectedPhoneButton" Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                    Click="UseSelectedPhone_Click" Content="로그인 폰 선택" />
                        </Grid>
                        <TextBlock x:Name="PhoneSelectionHint" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}"
                                   Text="등록된 휴대폰 중 하나를 선택" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="EnableLoginButton" Click="TestAndEnable_Click" Content="휴대폰 로그인 켜기" />
                            <Button x:Name="DisableLoginButton" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                                    Click="DisableLogin_Click" Content="끄기" Visibility="Collapsed" />
                        </StackPanel>
                        <TextBlock x:Name="TestResultText" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" Padding="18" Background="White" BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="1" CornerRadius="12">
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="자동화" />
                        <CheckBox x:Name="RemoteUnlockCheckBox" Margin="0,12,0,0" FontSize="14"
                                  Content="휴대폰에서 원격 잠금 해제 허용" Click="RemoteUnlock_Click" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="자동 잠금 프로필" />
                            <ComboBox x:Name="AutoLockProfileComboBox" Margin="12,0,0,0" Width="120"
                                      SelectionChanged="AutoLockProfile_SelectionChanged">
                                <ComboBoxItem Content="표준" Tag="standard" />
                                <ComboBoxItem Content="집" Tag="home" />
                                <ComboBoxItem Content="외출" Tag="away" />
                            </ComboBox>
                        </StackPanel>
                        <CheckBox x:Name="ProximityLockCheckBox" Margin="0,10,0,0" FontSize="14"
                                  Content="휴대폰이 멀어지면 PC 잠금" Click="ProximityLock_Click" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="휴대폰 이탈 대기" />
                            <ComboBox x:Name="ProximityGraceComboBox" Margin="12,0,0,0" Width="100"
                                      SelectionChanged="ProximityGrace_SelectionChanged">
                                <ComboBoxItem Content="10초" Tag="10" />
                                <ComboBoxItem Content="30초" Tag="30" />
                                <ComboBoxItem Content="60초" Tag="60" />
                                <ComboBoxItem Content="120초" Tag="120" />
                            </ComboBox>
                        </StackPanel>
                        <CheckBox x:Name="ProximityUnlockCheckBox" Margin="0,12,0,0" FontSize="14"
                                  Content="휴대폰이 가까워지면 자동 로그인 (보안 낮음)" Click="ProximityUnlock_Click" />
                        <CheckBox x:Name="BluetoothRssiCheckBox" Margin="0,12,0,0" FontSize="14"
                                  Content="Bluetooth RSSI 거리로 자동 잠금" Click="BluetoothRssi_Click" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="가까움 기준" />
                            <ComboBox x:Name="BluetoothRssiThresholdComboBox" Margin="12,0,0,0" Width="100"
                                      SelectionChanged="BluetoothRssiThreshold_SelectionChanged">
                                <ComboBoxItem Content="-60 dBm" Tag="-60" />
                                <ComboBoxItem Content="-70 dBm" Tag="-70" />
                                <ComboBoxItem Content="-75 dBm" Tag="-75" />
                                <ComboBoxItem Content="-85 dBm" Tag="-85" />
                            </ComboBox>
                        </StackPanel>
                        <TextBlock x:Name="ProximityAgentStatusText" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" />
                        <Button x:Name="StartAgentButton" Margin="0,8,0,0" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left" Click="StartAgent_Click" Content="자동잠금 감시 시작" />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" Padding="18" Background="White" BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="1" CornerRadius="12">
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="재실 센서" />
                        <CheckBox x:Name="PresenceSensorCheckBox" Margin="0,12,0,0" FontSize="14"
                                  Content="사람이 없으면 PC 잠금" Click="PresenceSensor_Click" />
                        <TextBlock Margin="0,12,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="연결 방식" />
                        <ComboBox x:Name="PresenceSensorProtocolComboBox" Margin="0,4,0,0"
                                  SelectionChanged="PresenceSensorProtocol_SelectionChanged">
                            <ComboBoxItem Content="Zigbee · Home Assistant" Tag="zigbee" />
                            <ComboBoxItem Content="Matter · Home Assistant" Tag="matter" />
                            <ComboBoxItem Content="SmartThings Station" Tag="smartthings" />
                        </ComboBox>
                        <TextBlock x:Name="PresenceSensorTargetHint" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}"
                                   Text="Home Assistant entity_id" />
                        <TextBox x:Name="PresenceSensorUrlInput" Margin="0,10,0,0" ToolTip="Home Assistant 주소"
                                 Text="http://homeassistant.local:8123" />
                        <TextBox x:Name="PresenceSensorEntityInput" Margin="0,8,0,0" ToolTip="sensor 또는 binary_sensor entity_id"
                                 Text="binary_sensor.room_presence" />
                        <StackPanel x:Name="SmartThingsFieldsPanel" Visibility="Collapsed">
                            <TextBox x:Name="PresenceSensorComponentInput" Margin="0,8,0,0" ToolTip="SmartThings component ID"
                                     Text="main" />
                            <TextBox x:Name="PresenceSensorCapabilityInput" Margin="0,8,0,0" ToolTip="SmartThings capability ID"
                                     Text="occupancySensor" />
                            <TextBox x:Name="PresenceSensorAttributeInput" Margin="0,8,0,0" ToolTip="SmartThings attribute name"
                                     Text="occupancy" />
                            <Button x:Name="FindSmartThingsSensorsButton" Margin="0,10,0,0"
                                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                    Click="FindSmartThingsSensors_Click" Content="SmartThings 센서 찾기" />
                            <ComboBox x:Name="SmartThingsSensorComboBox" Margin="0,8,0,0"
                                      DisplayMemberPath="DisplayName" Visibility="Collapsed"
                                      SelectionChanged="SmartThingsSensor_SelectionChanged" />
                        </StackPanel>
                        <PasswordBox x:Name="PresenceSensorTokenInput" Margin="0,8,0,0" ToolTip="Home Assistant 장기 액세스 토큰" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="감지 해제 후" />
                            <ComboBox x:Name="PresenceSensorGraceComboBox" Margin="12,0,0,0" Width="100"
                                      SelectionChanged="PresenceSensorGrace_SelectionChanged">
                                <ComboBoxItem Content="10초" Tag="10" />
                                <ComboBoxItem Content="30초" Tag="30" />
                                <ComboBoxItem Content="60초" Tag="60" />
                            </ComboBox>
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="뒤 잠금" />
                        </StackPanel>
                        <TextBlock x:Name="PresenceSensorStateText" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" Padding="18" Background="White" BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="1" CornerRadius="12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="보안 기록" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="AuditRefresh_Click" Content="새로 고침" />
                        </Grid>
                        <ListBox x:Name="AuditList" Margin="0,10,0,0" Height="180" BorderThickness="0" Background="#F8F9FB" FontSize="12" />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" Padding="18" Background="White" BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="1" CornerRadius="12">
                    <StackPanel>
                        <Button x:Name="DiagnosticsButton" Click="Diagnostics_Click" Content="이 PC 연결 진단" HorizontalAlignment="Left" />
                        <TextBlock x:Name="DiagnosticsSummaryText" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <TextBlock x:Name="OperationStatusText" Margin="0,14,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Window>
